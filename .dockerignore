# Ignore dependencies installed locally.
# Docker installs what it needs inside the image, so local node_modules should
# never be sent in the build context.
**/node_modules

# Ignore local build outputs. These are recreated during the Docker build.
backend/dist
frontend/dist

# Ignore Git metadata and local Git config files.
.git
.gitignore

# Ignore environment files that may contain secrets.
# Keep example env files so deployment/reference templates still ship if needed.
**/.env
**/.env.*
!**/.env.example

# Ignore logs created during local development.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore OS/editor/generated local files that are not needed in the image.
.DS_Store
.vscode
.idea
coverage
